{
  "schema": "agent-systems-lab/compatibility/v1",
  "contract_version": 1,
  "authority": "agent-proof",
  "repository": "https://github.com/jonah-ux/agent-proof",
  "canonicalization": {
    "allow_nan": false,
    "encoding": "utf-8",
    "json": "sorted-keys-compact"
  },
  "identifiers": {
    "max_length": 128,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
  },
  "statuses": [
    "blocked",
    "failed",
    "observed",
    "partial",
    "unknown",
    "unavailable",
    "verified"
  ],
  "refusal_codes": [
    {
      "code": "digest_mismatch",
      "class": "integrity",
      "meaning": "The bytes or digest do not match the admitted source."
    },
    {
      "code": "duplicate_identifier",
      "class": "identity",
      "meaning": "A manifest contains an identifier more than once."
    },
    {
      "code": "malformed_manifest",
      "class": "input",
      "meaning": "The compatibility document does not satisfy its structural contract."
    },
    {
      "code": "redaction_violation",
      "class": "privacy",
      "meaning": "A boundary attempts to export a denied raw or private value."
    },
    {
      "code": "source_unbound",
      "class": "provenance",
      "meaning": "A projection cannot be traced back to the admitted source bytes."
    },
    {
      "code": "stale_source_identity",
      "class": "provenance",
      "meaning": "The source identity no longer matches the recorded revision or digest."
    },
    {
      "code": "unknown_version",
      "class": "compatibility",
      "meaning": "The producer or consumer version is outside the supported range."
    },
    {
      "code": "unsafe_path",
      "class": "filesystem",
      "meaning": "A path escapes the declared artifact boundary or uses an unsafe link."
    },
    {
      "code": "unsupported_schema",
      "class": "compatibility",
      "meaning": "The input schema is not a reviewed native or adapter schema."
    },
    {
      "code": "unsupported_status",
      "class": "compatibility",
      "meaning": "A lifecycle status is not in the bounded cross-repository vocabulary."
    }
  ],
  "redaction": {
    "private_paths": false,
    "provider_credentials": false,
    "raw_payloads": false,
    "secrets": false
  },
  "owner_codes": {
    "fields": [
      "owner_status",
      "owner_code"
    ],
    "mode": "preserve-verbatim",
    "unknown_policy": "do-not-infer"
  },
